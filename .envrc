#!/usr/bin/env bash
# direnv: put the devkit, stage3, stage4 and ZLS on PATH inside this repo.
. ./common.sh
PATH_add "$ZIGROOTBIN"
# PATH_add "$CMAKE_BIN"
PATH_add "$DEVKIT/bin"
PATH_add "$ZIG_STAGE3_BIN"
PATH_add "$ZIG_STAGE4_BIN"
PATH_add "$ZLS_BIN"

alias_set devkit-zig "$DEVKIT_ZIG_EXE"
alias_set web4 "$ZIGROOT/build-stage4-debug.sh -fincremental  --webui=127.0.0.1:9001"
alias_set build4 "$ZIGROOT/build-stage4-debug.sh"
alias_set watch4 "$ZIGROOT/build-stage4-debug.sh -fincremental  --watch"
